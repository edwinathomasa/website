# Local dev server port
PORT=3000

# MongoDB Atlas connection
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="portfolio"
PROFILE_SLUG="edwin-thomas"

# Allowed CORS origin(s) for local dev server (comma-separated or *)
CORS_ORIGIN="http://localhost:5173"

# Optional: Explicitly select the primary AI provider ('gemini' | 'openai' | 'claude')
AI_PROVIDER="gemini"

# Optional: Override default model for the active provider
# Defaults: gemini -> "gemini-2.5-flash" | openai -> "gpt-4o-mini" | claude -> "claude-3-5-sonnet-latest"
AI_MODEL=""

# Configure one or more LLM providers (automatic fallback order)
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY=""
CLAUDE_API_KEY=""

# ElevenLabs Cloned Voice TTS & Scribe STT
ELEVENLABS_API_KEY="sk_..."
ELEVENLABS_VOICE_ID="your_cloned_voice_id_here"
