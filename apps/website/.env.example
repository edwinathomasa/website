# Production API Gateway HTTP API base URL (e.g., https://abc123.execute-api.eu-north-1.amazonaws.com)
# Leave empty during local development to use Vite's /api proxy -> http://localhost:3000
VITE_API_BASE_URL=""

# Optional: Local backend target for Vite dev proxy (defaults to http://localhost:3000)
# VITE_DEV_API_TARGET="http://localhost:3000"
