# Optional: Explicitly select the primary AI provider ('gemini' | 'openai' | 'claude')
# If omitted, the server automatically uses whichever provider API key is configured below.
AI_PROVIDER="gemini"

# Optional: Override the default model for the active provider
# Defaults: gemini -> "gemini-2.5-flash" | openai -> "gpt-4o-mini" | claude -> "claude-3-5-sonnet-latest"
AI_MODEL=""

# Configure one (or multiple for automatic fallback) of the AI providers below:
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY=""
CLAUDE_API_KEY=""

# ElevenLabs Cloned Voice TTS & Scribe STT
ELEVENLABS_API_KEY="sk_..."
ELEVENLABS_VOICE_ID="your_cloned_voice_id_here"
